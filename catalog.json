{
  "version": 1,
  "repo": "brainfish-ai/ballet-support-playbooks",
  "ref": "main",
  "templates": [
    {
      "id": "freshdesk-ticket-summary",
      "title": "Freshdesk Ticket Summary",
      "summary": "Summarise each new Freshdesk ticket in three bullets and add it as a private note for the agent who picks it up.",
      "category": "support",
      "tags": [
        "freshdesk",
        "support",
        "summary",
        "webhook",
        "llm"
      ],
      "difficulty": "beginner",
      "trigger": "Freshdesk webhook (ticket created)",
      "integrations": [
        "freshdesk"
      ],
      "mcpServers": [],
      "secrets": [
        "FRESHDESK_WEBHOOK_SECRET",
        "FRESHDESK_DOMAIN",
        "FRESHDESK_API_KEY",
        "FRESHDESK_API_PASSWORD"
      ],
      "agents": [
        "ticket-summarizer"
      ],
      "steps": 2,
      "path": "templates/freshdesk-ticket-summary"
    },
    {
      "id": "support-reply-drafter",
      "title": "Support Reply Drafter",
      "summary": "Paste a customer message and get a polite, source-aware draft reply to review and send.",
      "category": "support",
      "tags": [
        "support",
        "drafting",
        "manual",
        "llm",
        "search"
      ],
      "difficulty": "beginner",
      "trigger": "Manual run",
      "integrations": [],
      "mcpServers": [],
      "secrets": [],
      "agents": [
        "support-reply-writer"
      ],
      "steps": 2,
      "path": "templates/support-reply-drafter"
    },
    {
      "id": "zendesk-ticket-triage",
      "title": "Zendesk Ticket Triage",
      "summary": "Classify every new Zendesk ticket with an LLM and write the priority and tags back as an internal note.",
      "category": "support",
      "tags": [
        "zendesk",
        "support",
        "triage",
        "webhook",
        "llm"
      ],
      "difficulty": "beginner",
      "trigger": "Zendesk webhook (ticket created)",
      "integrations": [
        "zendesk"
      ],
      "mcpServers": [],
      "secrets": [
        "ZENDESK_API_TOKEN",
        "ZENDESK_SUBDOMAIN"
      ],
      "agents": [
        "ticket-classifier"
      ],
      "steps": 2,
      "path": "templates/zendesk-ticket-triage"
    }
  ]
}
